# 프로젝트 정보
PROJECT_NAME=FIT-DNA API
VERSION=1.0.0

# 데이터베이스
DATABASE_URL=sqlite:///./fitdna.db
# PostgreSQL 예시: postgresql://username:password@localhost:5432/fitdna

# JWT 인증 — 반드시 채우기. 예: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# 파일 업로드
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# 외부 API
WEATHER_API_KEY=your-weather-api-key
KAKAO_REST_API_KEY=your-kakao-api-key

# 모델 파일 경로 (data/ 로 이동됨)
FITDNA_REFERENCE_TABLE=../data/fitdna_original_reference.pkl
EXERCISE_RECOMMENDATION_FILE=../data/phase2_classified_exercise_database.csv
